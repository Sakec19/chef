# Fridge Chef — environment variables (copy to .env locally; set in Vercel Dashboard for deploys)
# NEVER commit real keys. Leave blank the providers you do not use.
# The app never sends a key — the key lives only on the host (Vercel).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: restrict which Origin may call /api/ai, e.g. https://your-app.vercel.app
# When unset, the function reflects the request Origin (same-origin works).
ALLOWED_ORIGIN=
